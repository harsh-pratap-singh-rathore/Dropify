{
  "name": "dropify",
  "version": "1.0.0",
  "description": "Dropify - Audiophile Liquid Glass Music Streaming Web Application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run start",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k \"npm run dev:frontend\" \"electron .\"",
    "build": "cd frontend && npm run build",
    "build:desktop": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win",
    "publish:release": "node scripts/publish_release.cjs",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "@distube/ytdl-core": "^5.0.1",
    "@xhayper/discord-rpc": "^1.5.1",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
