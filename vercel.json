{
  "services": {
    "frontend": {
      "root": "frontend",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://dropify-backend-wy9v.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
